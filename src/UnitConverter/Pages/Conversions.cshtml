@page "/Conversions/{conversionType}/{input}"
<!-- route parameters from page model -->
@model UnitConverter.Pages.ConversionsModel

@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>

<div>

    @if (Model.inputErrorIsThrown)
    {
        <p class="text-danger">@ViewData["InputErrorMessage"]</p>
    }
    else if (Model.conversionTypeErrorIsThrown)
    {
        <p class="text-danger">@ViewData["ConversionTypeErrorMessage"]</p>
    }
    else
    {
        <h1>@Model.ConversionType</h1>

        <p> Input: @Model.Input</p>

        <p> Output: @Model.Output</p>
    }

    <a href="/Index">Return to the conversion form</a>

</div>
</body>
</html>
