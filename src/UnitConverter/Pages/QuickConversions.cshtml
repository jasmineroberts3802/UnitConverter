@page
@model UnitConverter.Pages.QuickConversions

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>

    <div>
        <a asp-page="/Index">Home</a>
    </div>

    <div>
        <form method="get">
            <div class="mb-3">
                <label class="form-label" asp-for="">Select conversion type</label>

                <select id="conversionType"
                        name="Conversion.ConversionType"
                        class="form-select">
                    @foreach (var conversion in ConversionTypes.All)
                    {
                        <option value="@conversion.Key">@conversion.Value</option>
                    }
                </select>
            </div>

            <input id="input"
                   name="Conversion.Input"
                   type="text"
                   class="form-control" />

            <button class="btn btn-primary">Convert</button>

        </form>
    </div>

</body>
</html>
